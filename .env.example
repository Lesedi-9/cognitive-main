# CognitiveAdapt configuration
# Copy this file to ".env" and fill in your Supabase project values
# (Supabase Dashboard -> Project Settings -> API).
#
# Leave both blank to run in LOCAL MODE: everything works offline and data is
# stored in this browser only (the first account created becomes the admin).
#
# Only the *anon* (public) key belongs here. NEVER put the service_role key in a
# VITE_ variable - Vite embeds these values into the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
